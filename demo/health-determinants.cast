[0.602, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mc:C\u001b[0m\u001b[33mountry\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:ENVIRONMENT_OF\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33me:E\u001b[0m\u001b[33mnvironmentalFactor\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WHERE \u001b[0m\r\n\u001b[33me.year = \u001b[0m\u001b[1;33m2019\u001b[0m\u001b[33m RETURN c.name AS country, \u001b[0m\u001b[1;33mround\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mavg\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33me.value\u001b[0m\u001b[1;33m)\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS air_burden ORDER \u001b[0m\r\n\u001b[33mBY air_burden DESC LIMIT \u001b[0m\u001b[1;33m5\u001b[0m\r\n"]
[0.006, "o", "  \u001b[32m→\u001b[0m highest WHO ambient air-pollution burden \u001b[1m(\u001b[0m\u001b[1;36m2019\u001b[0m\u001b[1m)\u001b[0m: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'China'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m195840\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[1;32m'India'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m136976\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Pakistan'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m85295\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Philippines'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m63322\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Nigeria'\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1;36m37681\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
