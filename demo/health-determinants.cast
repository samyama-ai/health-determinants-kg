[0.605, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mc:C\u001b[0m\u001b[33mountry\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:WATER_RESOURCE_OF\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mw:WaterResource \u001b[0m\r\n\u001b[1;33m{\u001b[0m\u001b[33mindicator_name: \u001b[0m\u001b[33m\"WSH_WATER_SAFELY_MANAGED\"\u001b[0m\u001b[1;33m}\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m RETURN c.name AS country, \u001b[0m\r\n\u001b[1;33mround\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mmin\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mw.value\u001b[0m\u001b[1;33m)\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS pct_safe_water ORDER BY pct_safe_water ASC LIMIT \u001b[0m\u001b[1;33m5\u001b[0m\r\n"]
[0.029, "o", "  \u001b[32m→\u001b[0m lowest % population with safely-managed water: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Lesotho'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[1;32m'Mozambique'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Tanzania'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Uganda'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m0\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Ethiopia'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m1\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
