[0.605, "o", "  \u001b[2mjoin WHO air-pollution burden with FAO sanitation coverage per country…\u001b[0m\r\n"]
[1.405, "o", "  \u001b[2mcypher>\u001b[0m \u001b[33mMATCH \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mc:C\u001b[0m\u001b[33mountry\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:ENVIRONMENT_OF\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33me:E\u001b[0m\u001b[33mnvironmentalFactor\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WHERE \u001b[0m\r\n\u001b[33me.year = \u001b[0m\u001b[1;33m2019\u001b[0m\u001b[33m WITH c, \u001b[0m\u001b[1;33mmax\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33me.value\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS air_burden MATCH \u001b[0m\r\n\u001b[1;33m(\u001b[0m\u001b[33mc\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m-\u001b[0m\u001b[1;33m[\u001b[0m\u001b[33m:WATER_RESOURCE_OF\u001b[0m\u001b[1;33m]\u001b[0m\u001b[33m->\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mw:WaterResource \u001b[0m\u001b[1;33m{\u001b[0m\u001b[33mindicator_name: \u001b[0m\r\n\u001b[33m\"WSH_SANITATION_SAFELY_MANAGED\"\u001b[0m\u001b[1;33m}\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m WITH c, air_burden, \u001b[0m\u001b[1;33mmax\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mw.value\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS sanitation\u001b[0m\r\n\u001b[33mWHERE air_burden > \u001b[0m\u001b[1;33m35.0\u001b[0m\u001b[33m AND sanitation < \u001b[0m\u001b[1;33m50.0\u001b[0m\u001b[33m RETURN c.name AS country, \u001b[0m\r\n\u001b[1;33mround\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33mair_burden\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS air_burden, \u001b[0m\u001b[1;33mround\u001b[0m\u001b[1;33m(\u001b[0m\u001b[33msanitation\u001b[0m\u001b[1;33m)\u001b[0m\u001b[33m AS pct_safe_sanitation"]
[0.000, "o", " ORDER \u001b[0m\r\n\u001b[33mBY air_burden DESC LIMIT \u001b[0m\u001b[1;33m5\u001b[0m\r\n"]
[0.028, "o", "  \u001b[32m→\u001b[0m double-burdened: dirty air + scarce safe sanitation: \u001b[1m[\u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Pakistan'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m85295\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1;36m41\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Nigeria'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m37681\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m36\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Viet Nam'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m19258\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m48\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Afghanistan'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m11292\u001b[0m\u001b[1m, \u001b[0m\r\n\u001b[1;36m25\u001b[0m\u001b[1m]\u001b[0m\u001b[1m, \u001b[0m\u001b[1m[\u001b[0m\u001b[1;32m'Thailand'\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m6910\u001b[0m\u001b[1m, \u001b[0m\u001b[1;36m30\u001b[0m\u001b[1m]\u001b[0m\u001b[1m]\u001b[0m\r\n"]
